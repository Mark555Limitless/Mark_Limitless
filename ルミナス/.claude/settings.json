{
  "permissions": {
    "ask": [
      "Edit(/CHARTER.md)",
      "Edit(/VIRTUAL_MARK.md)",
      "Edit(/ROUTINE.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/AGENTS.md)",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Edit(/.githooks/**)",
      "Bash(git push *)",
      "Edit(/prompts/ルミナス_最終プロンプト.md)",
      "Edit(/scripts/secret-scan.sh)",
      "Edit(/scripts/sync-obsidian.sh)",
      "Edit(/scripts/build-final-prompt-docx.mjs)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/.mcp.json)",
      "mcp__github__push_files",
      "mcp__github__create_or_update_file",
      "mcp__github__delete_file",
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__create_repository",
      "mcp__Google_Drive__share_file",
      "mcp__Google_Drive__create_file",
      "mcp__Google_Drive__update_file",
      "mcp__Google_Drive__trash_file",
      "mcp__Slack__slack_send_message",
      "mcp__Slack__slack_schedule_message",
      "mcp__Gmail__create_draft",
      "mcp__Notion__notion-create-pages",
      "mcp__Notion__notion-update-page",
      "Edit(/orch/**)",
      "Edit(/tools/**)",
      "Edit(/.env.example)",
      "Edit(/docs/review.md)"
    ],
    "deny": [
      "Bash(printenv *)",
      "Bash(env *)",
      "Read(.env)",
      "Read(**/.env.*)",
      "Read(/.claude/settings.local.json)",
      "Read(**/*.pem)",
      "Read(**/*.p8)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/credentials.json)",
      "Read(**/.netrc)",
      "Read(/data/**/.env*)",
      "Edit(/.env)",
      "Read(//**/ルミナス_非公開/**)",
      "Read(//**/env_backups/**)",
      "Edit(/data/.luminous_halt)",
      "Write(/data/.luminous_halt)",
      "Edit(**/data/.luminous_halt)",
      "Write(**/data/.luminous_halt)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/restore-charter.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'P=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; if [ -e \"$P/data/.luminous_halt\" ] || [ -L \"$P/data/.luminous_halt\" ]; then bash \"$P/.claude/hooks/halt-guard.sh\"; rc=$?; [ \"$rc\" = 0 ] && exit 0; echo \"全体停止中（data/.luminous_halt）\" >&2; exit 2; fi; exec bash \"$P/.claude/hooks/halt-guard.sh\"'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/codex-lock-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/mark-edited.sh\""
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-model-switch.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-gate.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-end.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
