# 鍵（値は Mark が tools/set_env_key.sh で入れる。このファイルには書かない）
GEMINI_API_KEY=
TYPESAFE_API_KEY=

# Gemini（orch.gemini）
ORCH_GEMINI=1
ORCH_GEMINI_MODEL=gemini-3.8-flash
ORCH_GEMINI_THINKING=high
ORCH_GEMINI_DAILY_USD_CAP=1.0
ORCH_GEMINI_PRICE_IN=0.75
ORCH_GEMINI_PRICE_OUT=3.75

# Jev（orch.decisions / orch.jev）
ORCH_JEV=1
ORCH_JEV_DAILY_MAX=60
ORCH_JEV_MONTHLY_USD=1.0
JEV_ENABLED=1
DECISION_BACKEND=jev
# 判断1回の時間の予算（ミリ秒）。claude -p の起動に数秒かかるため、Mac で --demo --backend anthropic を実測して決める
DECISION_TIMEOUT_MS=8000

# Codex（tools/codex_impl.sh・tools/codex_opinion.sh）。CODEX_MODEL を空にすると ~/.codex/config.toml の既定（現在 gpt-6-astra）
CODEX_MODEL=
CODEX_FALLBACK_MODEL=gpt-5.6-sol
