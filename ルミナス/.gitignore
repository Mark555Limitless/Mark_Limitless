# 秘匿情報・ローカル設定（憲章 I-4）
.env
.env.*
!.env.example
*.key
*.pem
*.p8
*.p12
secrets/
.claude/settings.local.json
# 鍵・資格情報の置き忘れ（guard-protected の SECRET・settings の deny と揃える。secret-scan は OAuth の client_secret の JSON・.netrc・
# 接頭辞の無いトークンを見逃すので、名前で公開を防ぐ。id_rsa*・id_ed25519* は公開鍵 .pub も含めて入れない）
.envrc
credentials.json
.netrc
id_rsa*
id_ed25519*

# OS / editor（._* と .AppleDouble は exFAT・SMB・unzip で Mac が作る付随ファイル）
.DS_Store
._*
.AppleDouble
Thumbs.db

# ルミナスの一時ファイル・依存
node_modules/
state/.session-start
state/.session-end.log

# Jev の判定ログ（JSON）
state/jev/
__pycache__/
*.pyc

# サポートAI の一時ファイル
docs/*-replies/*.err
# セッション別の一時ファイル
state/.sessions/

# 分譲指示書 §4: 稼働データ・ログ・仮想環境（git の管理外）
data/
logs/
.venv/
.pytest_cache/
